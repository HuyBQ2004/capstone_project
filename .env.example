# .env cho docker-compose.yml ở ROOT (không phải .env của Backend/Frontend — 2 cái đó riêng,
# compose tự load qua env_file). Copy thành .env rồi điền.

# RAG service (04_Development/AiServices/rag_service) đọc riêng biến này qua os.getenv, KHÔNG
# qua DB/UI như Gemini của MF12 — lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chỉ cần khi chạy `docker compose --profile tunnel up` (có domain thật qua Cloudflare Tunnel).
# Lấy tại: Cloudflare Zero Trust dashboard → Networks → Tunnels → tạo tunnel mới → copy token.
TUNNEL_TOKEN=

# ── CHỈ trên VPS production (docker-compose.prod.yml) — máy dev để trống, không dùng tới ──
# Namespace/project GitLab Container Registry, khớp $CI_REGISTRY_IMAGE mà pipeline push lên.
# VD: registry.gitlab.com/ten-nhom/sfms (chữ thường, đúng path project trên GitLab).
REGISTRY_IMAGE=
# Tag image muốn chạy — để trống = "latest" (bản mới nhất nhánh main vừa build). Có thể ghim
# cứng về một SHA cụ thể (VD: a1b2c3d) để rollback tạm mà không cần build lại.
IMAGE_TAG=
# Cổng HOST cho nginx — mặc định 80. Đổi khi cổng 80 trên máy đã bị chiếm bởi dịch vụ khác
# (VD VPS có sẵn Coolify/Traefik dùng 80/443). Cổng 80 TRONG container không đổi, Cloudflare
# Tunnel vẫn trỏ http://nginx:80 nội bộ như cũ, không cần sửa gì ở phía Tunnel.
NGINX_HOST_PORT=
# ── Trợ lý AI: chọn nhà cung cấp mô hình ──────────────────────────────────────────
# MẶC ĐỊNH (không khai gì) = Gemini, dùng cho production.
#
# Muốn chạy mô hình LOCAL lúc dev (LM Studio / Ollama / vLLM — bất kỳ máy chủ nào nói
# giao thức OpenAI `/v1/chat/completions`), thêm 2 dòng dưới vào `.env` của bạn:
#
#   COMPOSE_FILE=docker-compose.yml;docker-compose.localai.yml   # Windows dùng ';', Linux/macOS dùng ':'
#   SFMS_AI_MODEL=google/gemma-4-e4b
#
# Vì sao cần: quota free tier Gemini cạn rất nhanh (đo 09/08/2026: 429 RESOURCE_EXHAUSTED).
# Chọn model: `gemma-4-e2b` trả lời chat cực nhanh (0.7s) nhưng KHÔNG giữ được khuôn JSON của
# gợi ý thực đơn; `gemma-4-e4b` chậm hơn (chat ~46s, gợi ý thực đơn ~68s) nhưng đúng khuôn và
# giữ đúng danh mục nguyên liệu (đo 8/8). Tên model phải khớp `GET http://127.0.0.1:1234/v1/models`.
#
# Ghi đè thêm nếu cần (xem docker-compose.localai.yml):
#   SFMS_AI_BASE_URL=http://host.docker.internal:1234/v1
#   SFMS_AI_TIMEOUT_SECONDS=180

    partnerId : UUID
    schoolId : UUID
    failedLoginAttempts : int
    lockedUntil : Instant
  }

  class RoleRecord {
    code : String
    name : String
  }

  class UserRoleAssignment {
    userId : UUID
    roleCode : String
    schoolId : UUID
  }

  class Permission {
    code : String
    module : String
    action : String

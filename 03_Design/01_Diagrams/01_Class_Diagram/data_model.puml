' ══════════════════════════════════════════════════════════════════════
' QUAN HỆ
' ══════════════════════════════════════════════════════════════════════

' --- Tài khoản, trường, lớp ---
UserAccount "n" --> "1" RoleRecord : giữ vai
RoleRecord "n" --> "n" Permission
UserAccount "n" --> "0..1" Partner : tài khoản của đối tác
SchoolRecord "1" *-- "n" AcademicYear
AcademicYear "1" *-- "n" Classroom
Classroom "1" o-- "n" Student
SchoolRecord "1" -- "1" SchoolConfig : trần chi phí, geofence

' --- Học sinh & hồ sơ sức khoẻ ---
Student "1" *-- "n" AllergyDeclaration
Student "1" *-- "n" ChronicConditionDeclaration
Student "1" *-- "n" HealthHistoryEvent
Student "1" -- "0..1" HealthRecord
ParentChild "n" --> "1" Student

' --- Đối tác & mua sắm ---
Partner "1" *-- "n" PartnerDocument
Partner "1" *-- "n" SupplierProduct : mặt hàng cung ứng
SupplierProduct "1" --> "1" CatalogIngredient : quy về danh mục trường
SupplierProduct "1" o-- "n" SupplierBatch : một mặt hàng, nhiều lô
PurchaseRequest "n" --> "1" Partner
PurchaseRequest "1" *-- "n" PurchaseItem
PurchaseRequest "1" o-- "n" Delivery
Delivery "1" --> "0..1" ReceivingSession
ReceivingSession "n" --> "1" Partner
ReceivingSession "1" --> "n" InventoryBatch : lô được nhận vào kho

' --- Thực đơn ---
Dish "1" *-- "n" DishIngredient
DishIngredient "n" --> "1" CatalogIngredient
MenuItem "n" --> "1" Partner : đơn vị lập
MenuItem "1" o-- "n" Dish : món của bữa
MenuItem "1" o-- "n" MenuVariant : thực đơn riêng theo chế độ ăn
MenuVariant "n" --> "1" DietGroup
MenuVariant "1" *-- "n" MenuVariantDish
MenuVariantDish "n" --> "1" Dish

' --- Kho & truy xuất nguồn gốc (BR-076) ---
InventoryBatch "n" --> "1" CatalogIngredient
InventoryTransaction "n" --> "1" InventoryBatch
InventoryTransaction "n" --> "0..1" Dish : món tiêu thụ lô này
InventoryTransaction "n" --> "0..1" MenuItem
PreparationRecord "n" --> "1" Dish
PreparationRecord "n" --> "n" InventoryBatch : lô đã dùng

' --- Kiểm soát ATTP ---
InspectionSession "n" --> "0..1" Dish
FoodSample "n" --> "1" Dish
FoodSample "n" --> "0..1" SampleLabRequest
SampleLabRequest "n" --> "1" ReceivingAuthority : nơi tiếp nhận
SampleLabRequest "n" --> "1" Incident
SafetySignoff "n" --> "1" SchoolRecord

' --- Sự cố ---
IncidentSourceReport "n" --> "0..1" Incident : gộp N báo cáo thành 1 sự cố
IncidentSourceReport "1" *-- "n" IncidentAffectedStudent
IncidentRecordDraft "1" --> "0..1" Incident
Incident "1" *-- "n" IncidentAffectedStudent
Incident "1" *-- "n" IncidentEvent : sổ sự kiện append-only
Incident "1" o-- "n" CorrectiveAction
Incident "n" --> "n" InventoryBatch : lô bị cách ly (BR-149)
CorrectiveAction "n" --> "0..1" InspectionSession : CAPA từ kiểm thực (BR-095)
CorrectiveAction "n" --> "0..1" Partner : đơn vị chịu trách nhiệm
ViolationRecord "n" --> "0..1" Incident
IncidentAffectedStudent "n" --> "1" Student

' --- Các bảng còn lại, nối về chủ sở hữu ---
InventoryBatch "1" o-- "0..1" QuarantineInfo : cách ly (BR-149)
StaffMember "n" --> "1" SchoolRecord
Classroom "n" --> "1" StaffMember : giáo viên chủ nhiệm
KitchenInspection "n" --> "1" Partner : bếp được kiểm tra
FridgeTempLog "n" --> "1" SchoolRecord
Announcement "n" --> "1" SchoolRecord
UserNotification "n" --> "n" RoleRecord : vai nhận
AuditLog "n" --> "1" UserAccount : ai thao tác
SecurityPolicy "1" -- "n" UserAccount : áp cho mọi tài khoản
ExternalIntegration "n" --> "1" SchoolRecord

' --- Phục vụ & phản hồi ---
StudentDistribution "n" --> "1" Student
StudentDistribution "1" *-- "n" ServingDish : suất ĐÓNG BĂNG lúc trao tay
ServingDish "n" --> "1" Dish
TeacherMealRecord "n" --> "1" Student
SpecialMealRequest "n" --> "1" Student
Feedback "n" --> "1" Student
Feedback "n" --> "0..1" Dish


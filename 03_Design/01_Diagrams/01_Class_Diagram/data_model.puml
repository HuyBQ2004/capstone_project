@startuml SFMS_DataModel

' ══════════════════════════════════════════════════════════════════════
' SFMS — MÔ HÌNH DỮ LIỆU (định hướng persistence / Spring Boot + JPA)
'
' Sinh từ mô hình mock đã kiểm chứng (03_Design/08_FrontEnd/Web/src/lib/mock-data.ts)
' nên khớp đúng những gì hệ thống thật sự chạy, không phải mô tả mong muốn.
' Bản song sinh: class_diagram.puml — cùng nội dung, nhìn theo hướng đối tượng.
'
' QUY ƯỚC
'   <<PK>>  khoá chính        <<FK>> khoá ngoại
'   /field  THUỘC TÍNH DẪN XUẤT — KHÔNG tạo cột, tính lúc đọc.
'           Vẽ chúng như cột lưu là nguồn của lệch dữ liệu: cùng một sự thật
'           tồn tại hai bản, không cơ chế đồng bộ.
' ══════════════════════════════════════════════════════════════════════

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle Rectangle
hide methods

package "Tài khoản & Phân quyền" #EEF2FF {
  entity UserAccount {
    +id : String <<PK>>
    +name : String
    +email : String
    ~phone : String
    +role : String
    ~school : String
    +status : Enum
    ~partnerId : String <<FK>>
    +lastLogin : String
  }
  entity RoleRecord {
    +id : String <<PK>>
    +name : String
    +description : String
    /users : Decimal <<derived>>
    +system : Boolean
    +permissions : List<String>
  }
  entity Permission {
    +id : String <<PK>>
    +name : String
    +module : String
    +description : String
  }
  entity SecurityPolicy {
    +id : String <<PK>>
    +maxLoginAttempts : Decimal
    +lockoutMinutes : Decimal
    +sessionTimeoutMinutes : Decimal
    +passwordMinLength : Decimal
    +requireSpecialChar : Boolean
    +requireNumber : Boolean
    +requireMixedCase : Boolean
    +noReuseLast3 : Boolean
    ~updatedAt : String
    ~updatedBy : String
  }
  entity AuditLog {
    +id : String <<PK>>
    +timestamp : String
    +actor : String
    ~ip : String
    +action : String
    +resource : String
    +result : "SUCCESS" | "BLOCKED"
  }
}


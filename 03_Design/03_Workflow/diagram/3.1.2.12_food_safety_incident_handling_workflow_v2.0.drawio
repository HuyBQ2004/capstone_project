  <diagram id="IncidentHandlingWorkflow" name="3.1.2.12. Food Safety Incident Handling Workflow">
    <mxGraphModel dx="1717" dy="1203" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane_container" parent="1" style="swimlane;html=1;childLayout=stackLayout;startSize=30;horizontal=1;fillColor=#f5f5f5;horizontalStack=1;resizeParent=1;resizeParentMax=0;resizeNext=0;dropTarget=0;collapsible=0;fontSize=14;fontStyle=1;align=center;" value="FOOD SAFETY INCIDENT HANDLING WORKFLOW" vertex="1">
          <mxGeometry height="2150" width="1730" x="110" y="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_reporter" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#FFE082;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="Incident Reporter" vertex="1">
          <mxGeometry height="2120" width="300" y="30" as="geometry" />
        </mxCell>
        <mxCell id="start_node" parent="lane_reporter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="135" y="50" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="lane_reporter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;1. Report Food Safety Incident&lt;/b&gt;&lt;br&gt;A teacher, parent, medical staff member, or catering company reports a suspected food safety incident." vertex="1">
          <mxGeometry height="70" width="210" x="45" y="110" as="geometry" />
        </mxCell>
        <mxCell id="lane_medical" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#D5E8D4;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="Medical Staff" vertex="1">
          <mxGeometry height="2120" width="410" x="300" y="30" as="geometry" />
        </mxCell>
        <mxCell id="P2h2fm18CsQvHv6-vZCa-1" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;3. Validate Incident Report&lt;/b&gt;&lt;div&gt;Medical Staff reviews the reported information and validates whether the case is related to a potential food safety incident.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="75" y="220" as="geometry" />
        </mxCell>
        <mxCell id="P2h2fm18CsQvHv6-vZCa-3" parent="lane_medical" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;4. Valid Incident?&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="115" y="320" as="geometry" />
        </mxCell>
        <mxCell id="P2h2fm18CsQvHv6-vZCa-15" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;5a. Notify Reporter &amp;amp; Archive&lt;/b&gt;&lt;br&gt;Send notification to reporter with details/reasons, and archive the unconfirmed case record." vertex="1">
          <mxGeometry height="70" width="220" x="95" y="460" as="geometry" />
        </mxCell>
        <mxCell id="end_node_unconfirmed" parent="lane_medical" style="ellipse;html=1;shape=endState;strokeWidth=2.5;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="190" y="565" as="geometry" />
        </mxCell>
        <mxCell id="step3" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;6. Assess Incident Severity&lt;/b&gt;&lt;br&gt;Assesses symptoms, affected students &amp;amp; potential risks" vertex="1">
          <mxGeometry height="70" width="180" x="115" y="660" as="geometry" />
        </mxCell>
        <mxCell id="P2h2fm18CsQvHv6-vZCa-22" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;7. Provide Medical Treatment&lt;/b&gt;&lt;div&gt;Medical Staff provides first aid, medical care, or arranges hospital transfer.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="95" y="760" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="lane_medical" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;8. High Severity&lt;br&gt;Incident?&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="115" y="860" as="geometry" />
        </mxCell>
        <mxCell id="step5" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;9. Activate Emergency Response&lt;/b&gt;&lt;br&gt;Initiates emergency actions &amp;amp; immediately alerts School Leadership" vertex="1">
          <mxGeometry height="70" width="180" x="115" y="990" as="geometry" />
        </mxCell>
        <mxCell id="step6" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;10. Start Investigation&lt;/b&gt;&lt;br&gt;Medical Staff initiates the formal investigation process" vertex="1">
          <mxGeometry height="70" width="180" x="115" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="step10" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;14. Collect Supporting Evidence&lt;/b&gt;&lt;br&gt;Reviews inspection records, photos, GPS logs, prep logs &amp;amp; audit trails" vertex="1">
          <mxGeometry height="70" width="190" x="110" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="step11" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;15. Identify Root Cause&lt;/b&gt;&lt;br&gt;Performs analysis to determine most likely cause of incident" vertex="1">
          <mxGeometry height="70" width="180" x="115" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="step12" parent="lane_medical" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;16. Root Cause&lt;br&gt;Confirmed?&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="180" x="115" y="1620" as="geometry" />
        </mxCell>
        <mxCell id="step13" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontSize=12;fillColor=#FFFFFF;strokeColor=#37474F;" value="&lt;b&gt;17. Request Add. Investigation&lt;/b&gt;&lt;br&gt;Performs additional testing. Escalate if max retries exceeded." vertex="1">
          <mxGeometry height="70" width="180" x="115" y="1750" as="geometry" />
        </mxCell>

        <mxCell id="lane_system" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#E1BEE7;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="SFMS" vertex="1">

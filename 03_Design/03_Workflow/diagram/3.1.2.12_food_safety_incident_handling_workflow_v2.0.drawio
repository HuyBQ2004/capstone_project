        <mxCell id="step2" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;2. Create Incident Record&lt;/b&gt;&lt;br&gt;The system creates an incident record and assigns a unique incident identifier." vertex="1">
          <mxGeometry height="70" width="200" x="90" y="110" as="geometry" />
        </mxCell>
        <mxCell id="step2b" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4A148C;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;2b. Notify Stakeholders&lt;/b&gt;&lt;br&gt;Triggers real-time alerts via FCM to School Admin and Parents (especially if high severity)" vertex="1">
          <mxGeometry height="70" width="220" x="80" y="220" as="geometry" />
        </mxCell>
        <mxCell id="step7" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;11. Retrieve Food Sample Logs&lt;/b&gt;&lt;br&gt;Retrieves food sample records associated with reported meal" vertex="1">
          <mxGeometry height="70" width="180" x="100" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="step8" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;12. Retrieve Ingredient Batches&lt;/b&gt;&lt;br&gt;Retrieves ingredient batch history used in meal preparation" vertex="1">
          <mxGeometry height="70" width="200" x="90" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="step9" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;13. Trace Supplier Info&lt;/b&gt;&lt;br&gt;Traces supplier data linked to suspected ingredient batches" vertex="1">
          <mxGeometry height="70" width="180" x="100" y="1310" as="geometry" />
        </mxCell>

<mxfile host="app.diagrams.net">
  <diagram id="FoodSampleRetentionWorkflow" name="3.1.2.8. Food Sample Retention &amp; Disposal Workflow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane_container" parent="1" style="swimlane;html=1;childLayout=stackLayout;startSize=30;horizontal=1;fillColor=#f5f5f5;horizontalStack=1;resizeParent=1;resizeParentMax=0;resizeNext=0;dropTarget=0;collapsible=0;fontSize=14;fontStyle=1;align=center;" value="FOOD SAMPLE RETENTION WORKFLOW" vertex="1">
          <mxGeometry height="1440" width="1000" x="50" y="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_catering" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#B3E5FC;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="Service Caterers" vertex="1">
          <mxGeometry height="1410" width="320" y="30" as="geometry" />
        </mxCell>
        <mxCell id="step2" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;2. Identify Meals for Retention&lt;/b&gt;&lt;br/&gt;Catering Staff identifies food items that require sample retention according to food safety regulations." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="100" as="geometry" />
        </mxCell>
        <mxCell id="step3" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;3. Collect Food Samples&lt;/b&gt;&lt;br/&gt;Catering Staff collects representative samples from each prepared food item." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="210" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;4. Label Food Samples&lt;/b&gt;&lt;br/&gt;Catering Staff labels each sample with meal information, production date, retention date, and batch reference." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="320" as="geometry" />
        </mxCell>
        <mxCell id="step5" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;5. Capture Evidence Photos&lt;/b&gt;&lt;br/&gt;Catering Staff captures photos of food samples and labels." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="430" as="geometry" />
        </mxCell>
        <mxCell id="step9" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;9. Store Food Samples&lt;/b&gt;&lt;br/&gt;Catering Staff places food samples in the designated retention storage area." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="760" as="geometry" />
        </mxCell>
        <mxCell id="step13" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;13. Dispose of Food Samples&lt;/b&gt;&lt;br/&gt;Catering Staff disposes retained samples according to food safety procedures." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="lane_system" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#E1BEE7;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="System" vertex="1">
          <mxGeometry height="1410" width="360" x="320" y="30" as="geometry" />
        </mxCell>
        <mxCell id="start_node" parent="lane_system" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="165" y="50" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;1. Complete Food Inspection&lt;/b&gt;&lt;br/&gt;The meal batch successfully passes all three food inspection steps." vertex="1">
          <mxGeometry height="70" width="180" x="90" y="100" as="geometry" />
        </mxCell>
        <mxCell id="step6" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;6. Capture GPS and Timestamp&lt;/b&gt;&lt;br/&gt;System automatically records GPS location, device information, and timestamp during sample retention." vertex="1">
          <mxGeometry height="90" width="180" x="90" y="420" as="geometry" />
        </mxCell>
        <mxCell id="step7" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;7. Verify Retention Location&lt;/b&gt;&lt;br/&gt;System verifies that sample retention is performed within the designated kitchen or storage area." vertex="1">
          <mxGeometry height="70" width="180" x="90" y="540" as="geometry" />
        </mxCell>
        <mxCell id="step8" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;8. Create Sample Record&lt;/b&gt;&lt;br/&gt;System creates a food sample record linked to menu, ingredient batches, inspection records, and production session." vertex="1">
          <mxGeometry height="70" width="180" x="90" y="650" as="geometry" />
        </mxCell>
        <mxCell id="step10" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;10. Record Storage Information&lt;/b&gt;&lt;br/&gt;System records storage location and retention expiration date." vertex="1">
          <mxGeometry height="70" width="180" x="90" y="760" as="geometry" />
        </mxCell>
        <mxCell id="step11" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;11. Monitor Retention Period&lt;/b&gt;&lt;br/&gt;System continuously monitors the required retention duration." vertex="1">
          <mxGeometry height="70" width="180" x="90" y="870" as="geometry" />
        </mxCell>
        <mxCell id="step12" parent="lane_system" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontColor=#263238;" value="&lt;b&gt;12. Retention Period Expired?&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0066cc&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;BR-111 (72h), BR-112, BR-113&lt;/b&gt;&lt;br/&gt;QĐ 1246/QĐ-BYT Điều 8.2&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="200" x="80" y="970" as="geometry" />
        </mxCell>
        <mxCell id="step14" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;fontSize=12;fontStyle=1;fillColor=#99ccff;strokeColor=#0066cc;" value="&lt;b&gt;14. Record Disposal Information&lt;/b&gt;&lt;br/&gt;System records disposal details, responsible staff, and timestamp." vertex="1">
          <mxGeometry height="70" width="180" x="90" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="end_node_success" parent="lane_system" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=2.5;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="70" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="step16" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontSize=12;fillColor=#99ccff;strokeColor=#0066cc;" value="&lt;b&gt;16. Record Investigation Usage&lt;/b&gt;&lt;br/&gt;System records sample retrieval and investigation activities." vertex="1">
          <mxGeometry height="70" width="180" x="130" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="lane_medical" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#D5E8D4;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="Medical Staff" vertex="1">
          <mxGeometry height="1410" width="320" x="680" y="30" as="geometry" />
        </mxCell>
        <mxCell id="step15" parent="lane_medical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontSize=12;fillColor=#99ccff;strokeColor=#0066cc;" value="&lt;b&gt;15. Retrieve Food Sample&lt;/b&gt;&lt;br/&gt;Medical Staff retrieves retained samples for investigation when a food safety incident occurs." vertex="1">
          <mxGeometry height="70" width="180" x="70" y="1120" as="geometry" />
        </mxCell>

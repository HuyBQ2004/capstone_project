        <mxCell id="step1" parent="lane_parent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;1. Submit Health Information&lt;/b&gt;&lt;br/&gt;Parent submits student health information, allergy details, and special dietary requirements." vertex="1">
          <mxGeometry height="70" width="180" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="lane_medical" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#D5E8D4;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="Medical Staff" vertex="1">

          <mxGeometry height="70" width="180" x="70" y="210" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="lane_medical" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontColor=#263238;" value="&lt;b&gt;4. Additional Verification Required?&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0066cc&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;BR-031, BR-030&lt;/b&gt;&lt;br/&gt;TTLT 13/2016/TTLT-BYT-BGDĐT&lt;/font&gt;" vertex="1">

        </mxCell>
        <mxCell id="lane_parent" parent="lane_container" style="swimlane;html=1;startSize=40;horizontal=1;collapsible=0;dropTarget=0;fillColor=#FFE082;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;" value="Parent" vertex="1">

          <mxGeometry height="70" width="180" x="70" y="460" as="geometry" />
        </mxCell>
        <mxCell id="edge4_6" edge="1" parent="lane_medical" source="step4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#C62828;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="step6" value="No">

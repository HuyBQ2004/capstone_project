          <mxGeometry height="1510" width="380" x="620" y="30" as="geometry" />
        </mxCell>
        <mxCell id="step2" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;2. Create Health Declaration Record&lt;/b&gt;&lt;br/&gt;System creates a health declaration record for review." vertex="1">
          <mxGeometry height="70" width="180" x="100" y="100" as="geometry" />
        </mxCell>
        <mxCell id="step5" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;5. Request Additional Information&lt;/b&gt;&lt;br/&gt;System requests additional information from the parent." vertex="1">
          <mxGeometry height="70" width="180" x="100" y="335" as="geometry" />
        </mxCell>
        <mxCell id="step7" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;7. Create Allergy Profile&lt;/b&gt;&lt;br/&gt;System creates or updates the student&#39;s allergy profile." vertex="1">
          <mxGeometry height="70" width="180" x="100" y="460" as="geometry" />
        </mxCell>
        <mxCell id="step8" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;8. Classify Special Meal Category&lt;/b&gt;&lt;br&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;line-height: 150%;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 12px;&quot;&gt;System classifies the student into predefined categories such as Seafood Allergy, Milk Allergy&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="180" x="100" y="570" as="geometry" />
        </mxCell>
        <mxCell id="step9" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;9. Generate Allergy Alerts&lt;/b&gt;&lt;br/&gt;System generates allergy alerts and distributes them to relevant stakeholders." vertex="1">
          <mxGeometry height="70" width="180" x="100" y="680" as="geometry" />
        </mxCell>
        <mxCell id="step10" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;10. Notify Service Caterers&lt;/b&gt;&lt;br/&gt;System sends allergy and special meal information to the Catering Company." vertex="1">
          <mxGeometry height="70" width="180" x="100" y="790" as="geometry" />
        </mxCell>
        <mxCell id="step13" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#99ccff;strokeColor=#0066cc;strokeWidth=1.5;fontSize=12;fontColor=#263238;" value="&lt;b&gt;13. Validate Menu Against Allergy Profiles&lt;/b&gt;&lt;br/&gt;System checks approved menu items against registered student allergy profiles and configured allergen information." vertex="1">
          <mxGeometry height="90" width="180" x="100" y="990" as="geometry" />
        </mxCell>
        <mxCell id="step14" parent="lane_system" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontColor=#263238;" value="&lt;b&gt;14. Allergy Conflict Detected?&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0066cc&quot; style=&quot;font-size:9px&quot;&gt;&lt;b&gt;BR-063, BR-065, BR-066, BR-123&lt;/b&gt;&lt;/font&gt;" vertex="1">

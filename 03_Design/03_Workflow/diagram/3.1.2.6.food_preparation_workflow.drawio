        <mxCell id="lane_container" parent="1" style="swimlane;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=30;horizontalStack=1;html=1;fontStyle=1;fontSize=14;" value="FOOD PREPARATION WORKFLOW" vertex="1">

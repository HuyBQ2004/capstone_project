          <mxGeometry height="30" width="30" x="150" y="40" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;1. Review Approved Menu&lt;/b&gt;&lt;br/&gt;Reviews approved menu &amp;&lt;br/&gt;meal production plan" vertex="1">
          <mxGeometry height="70" width="180" x="75" y="100" as="geometry" />
        </mxCell>
        <mxCell id="step2" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="&lt;b&gt;2. Retrieve Ingredients&lt;/b&gt;&lt;br/&gt;Collects approved ingredients&lt;br/&gt;from preparation area" vertex="1">
          <mxGeometry height="70" width="180" x="75" y="200" as="geometry" />
        </mxCell>
        <mxCell id="step3" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99ccff;strokeColor=#0066cc;" value="&lt;b&gt;3. Verify Ingredient Info&lt;/b&gt;&lt;br/&gt;Verifies batches, quantities &amp;&lt;br/&gt;expiration dates before use" vertex="1">
          <mxGeometry height="70" width="180" x="75" y="300" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99ccff;strokeColor=#0066cc;" value="&lt;b&gt;4. Prepare Ingredients&lt;/b&gt;&lt;br/&gt;Washes, cuts &amp; prepares&lt;br/&gt;ingredients for processing" vertex="1">
          <mxGeometry height="70" width="180" x="75" y="400" as="geometry" />

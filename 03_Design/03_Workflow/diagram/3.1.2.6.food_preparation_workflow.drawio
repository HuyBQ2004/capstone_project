        <mxCell id="step5" parent="lane_system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#99ccff;strokeColor=#0066cc;" value="&lt;b&gt;5. Record Pre-processing&lt;/b&gt;&lt;br/&gt;Records activities, responsible&lt;br/&gt;staff &amp; timestamps in audit logs" vertex="1">

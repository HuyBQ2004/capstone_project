          <mxGeometry height="70" width="180" x="75" y="500" as="geometry" />
        </mxCell>
        <mxCell id="step8" parent="lane_catering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="&lt;b&gt;8. Complete Meal Prep&lt;/b&gt;&lt;br/&gt;Completes meal production&lt;br/&gt;&amp; prepares meals for inspection" vertex="1">
          <mxGeometry height="70" width="180" x="75" y="600" as="geometry" />

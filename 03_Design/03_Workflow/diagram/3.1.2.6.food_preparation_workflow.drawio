        <mxCell id="lane_catering" parent="lane_container" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;fontStyle=1;" value="&lt;span style=&quot;color: rgb(0, 0, 0); background-color: rgb(236, 236, 236);&quot;&gt;Service Caterers&lt;/span&gt;" vertex="1">
          <mxGeometry height="850" width="330" y="30" as="geometry" />
        </mxCell>

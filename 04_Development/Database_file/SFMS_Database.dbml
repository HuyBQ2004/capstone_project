// GHI CHÚ BỔ SUNG
// ═══════════════════════════════════════════════════════════════════════════════

// ─── 7 VIEW read-only (V30__mf13_report_views.sql — ADR-M13-1) ────────────────
// DBML không mô tả được view; liệt kê ở đây để không thất lạc.
// BR-182: mọi số liệu tính TRỰC TIẾP từ bảng nguồn. BR-181: view KHÔNG chọn cột PII học sinh.
//   v_rpt_three_step        <- inspection_sessions + user_accounts + dishes
//   v_rpt_sample_retention  <- food_samples
//   v_rpt_receiving         <- receiving_sessions + partners + receiving_lines
//   v_rpt_supplier_cert     <- partners + supplier_partnerships + partner_documents
//   v_rpt_hygiene           <- kitchen_inspections + user_accounts
//   v_rpt_traceability      <- inventory_batches + partners
//   v_rpt_system_usage      <- user_accounts + roles

// ─── THAM CHIẾU MỀM (ID thuần, CỐ Ý không khai FK) — không vẽ thành Ref ───────
//   food_samples.inspection_id            -> inspection_sessions.id   (ADR-M08-5)
//   food_samples.dish_id / menu_id        -> dishes.id / menus.id     (ADR-M08-5)
//   food_samples.incident_id              -> incidents.id             (ADR-M08-5)
//   sample_lab_requests.incident_id       -> incidents.id             (ADR-M08-5)
//   incident_affected_students.student_id -> students.id              (M11-D11)
//   incident_suspected_dishes.dish_id     -> dishes.id                (M11-D11)
//   incident_quarantine_batches.batch_id  -> inventory_batches.id     (M11-D11)
//   inventory_batches.quarantine_incident_id -> incidents.id
//   incident_source_reports.reported_by_id, incidents.closed_by_id,
//     incident_records.created_by_id, violation_records.recorded_by_id /
//     caterers_representative_id / handled_by_id -> user_accounts.id  (M11-D06)
//   health_documents.uploaded_by_user_id, allergy_declarations.declared_by_user_id /
//     verified_by_user_id, special_meal_requests.requested_by_user_id /
//     reviewed_by_user_id, health_history_events.by_user_id -> user_accounts.id
//   inspection_evidences.owner_id, sample_attachments.owner_id -> polymorphic
//
// Lý do: hồ sơ pháp lý giữ 10 năm không được vỡ khi bản ghi gốc đổi/xoá, và tránh
// khoá thứ tự migrate giữa các module. Muốn dbdiagram vẽ thêm thì thêm dòng Ref —
// nhưng KHÔNG export SQL từ đó ngược về DB thật.

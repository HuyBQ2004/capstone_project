# Copy thành .env (đã có trong .gitignore) rồi điền giá trị thật.
# ADR-000 mục 2 / ADR-001 mục 2: KHÔNG commit secret thật — chỉ commit file .example này.
#
# Domain thật: sfsm.io.vn (BE: api.sfsm.io.vn, FE: sfsm.io.vn, CDN ảnh: cdn.sfsm.io.vn).

# ─── Database (Postgres) ──────────────────────────────────────────────────────
# Local/dev: giữ default là chạy được ngay (docker-compose postgres).
# Production: đổi sang host/container postgres thật trên VPS, đặt password mạnh (>=20 ký tự random).
DB_URL=jdbc:postgresql://localhost:5432/sfms
DB_USER=sfms
DB_PASSWORD=sfms

# ─── Server ────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── JWT (đăng nhập / phân quyền) ─────────────────────────────────────────────
# JWT_SECRET: chuỗi bí mật ký access/refresh token — BẮT BUỘC đổi ở production, KHÔNG dùng giá trị dev.
#   Cách lấy: tự sinh, không lấy từ đâu cả. Chạy 1 trong các lệnh sau và dán kết quả:
#     openssl rand -base64 48
#     PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
#   Yêu cầu: HS256 cần khoá >=256-bit (32 byte) — lệnh trên cho ra dư dài, đủ an toàn.
JWT_SECRET=
JWT_ISSUER=sfms

# ─── Google OAuth2 Login ("Đăng nhập bằng Google") ───────────────────────────
# Lấy tại: https://console.cloud.google.com/apis/credentials
#   1. Tạo project mới (hoặc chọn project có sẵn) trên Google Cloud Console.
#   2. Vào "APIs & Services" → "OAuth consent screen": điền tên app "SFMS", chọn External,
#      giữ scope mặc định (email/profile/openid).
#   3. Vào "Credentials" → "Create Credentials" → "OAuth client ID" → Application type =
#      "Web application".
#   4. Authorized redirect URIs — điền ĐÚNG URL callback của Spring Security OAuth2 Client:
#        https://api.sfsm.io.vn/login/oauth2/code/google        (production)
#        http://localhost:8080/login/oauth2/code/google         (local dev)
#   5. Sau khi tạo, Google hiện "Client ID" và "Client secret" — copy 2 giá trị đó vào 2 biến dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sau khi Google login xong, FE nhận token redirect về URL nào (domain thật của FE):
# PHẢI đúng domain đang thật sự route tới frontend (kiểm bằng Cloudflare Tunnel → Published
# application routes) — KHÔNG phải domain gốc nếu chỉ "www" được route, lệch domain ở đây
# không gây lỗi rõ ràng (backend vẫn redirect được) nhưng trình duyệt sẽ 404 ở bước cuối.
OAUTH2_SUCCESS_REDIRECT=https://www.sfsm.io.vn/auth/callback

# ─── SMTP (Gmail) — gửi email thật: kích hoạt tài khoản, reset password, thông báo ───
# Lấy tại: https://myaccount.google.com/apppasswords (cần bật 2-Step Verification trước ở
# https://myaccount.google.com/security — nếu chưa bật sẽ không thấy mục "App passwords").
#   1. Bật 2-Step Verification cho Gmail account dùng để gửi mail (vd noreply@sfsm.io.vn nếu có
#      Google Workspace, hoặc 1 Gmail thường nếu chưa có Workspace).
#   2. Vào "App passwords" → chọn app "Mail", thiết bị "Other" → đặt tên "SFMS Backend" → Generate.
#   3. Google hiện 1 mã 16 ký tự (dạng "abcd efgh ijkl mnop") — đây là SMTP_PASSWORD, KHÔNG phải
#      mật khẩu Gmail thường (mật khẩu thường sẽ bị Google chặn).
#   4. SMTP_USER = địa chỉ Gmail đầy đủ dùng để gửi (vd noreply@sfsm.io.vn hoặc yourname@gmail.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# ─── Object storage (common/storage) ──────────────────────────────────────────
# "local" (mặc định, ADR-000): ghi vào ./data/uploads, không cần R2. Dùng cho dev/local.
# "r2" (ADR-001 mục 6): BẮT BUỘC ở production — đổi STORAGE_PROVIDER=r2 và điền đủ 5 biến R2_*.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads

# Cloudflare R2 — lấy tại: https://dash.cloudflare.com → chọn account → mục "R2 Object Storage".
#   1. Nếu chưa có bucket: "Create bucket" → tên "sfsm" (khớp R2_BUCKET dưới).
#   2. R2_ENDPOINT: vào bucket vừa tạo → tab "Settings" → mục "S3 API" → copy dòng
#      "https://<account-id>.r2.cloudflarestorage.com" (account-id lấy từ URL dashboard hoặc
#      trang "Account Home" bên trái sidebar).
#   3. R2_ACCESS_KEY / R2_SECRET_KEY: vào "R2" → "Manage R2 API Tokens" (nút "API" góc phải) →
#      "Create API token" → quyền "Object Read & Write", scope giới hạn bucket "sfsm" → Create →
#      Cloudflare hiện Access Key ID + Secret Access Key (CHỈ hiện 1 LẦN, copy ngay lúc tạo).
#   4. R2_PUBLIC_BASE_URL: để ảnh/file truy cập qua domain riêng (có CDN + TLS) thay vì URL R2 gốc:
#      vào bucket → "Settings" → "Public Access" → "Connect Domain" → nhập "cdn.sfsm.io.vn"
#      (cần domain sfsm.io.vn đã trỏ DNS qua Cloudflare trước — Cloudflare tự cấp cert TLS).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=sfsm
R2_PUBLIC_BASE_URL=https://cdn.sfsm.io.vn

# ─── Mã hoá dữ liệu nhạy cảm (BR-051, D10-BIS) ────────────────────────────────
# MF04_NATIONAL_ID_KEY: khoá AES-256 mã hoá CCCD nhân viên giao hàng at-rest. BẮT BUỘC đổi ở
# production, phải là 32 byte encode base64 (giá trị dev hiện tại KHÔNG được dùng thật).
#   Cách lấy: tự sinh — openssl rand -base64 32
MF04_NATIONAL_ID_KEY=

# SFMS_CRED_MASTER_KEY: khoá AES-256-GCM mã hoá credential của các dịch vụ tích hợp ngoài
# (GPS provider, Gemini AI, Firebase Cloud Messaging...) mà System Admin nhập qua màn hình
# "Tích hợp hệ thống" (MF12) — các API key đó KHÔNG nằm trong .env, chỉ nằm trong DB đã mã hoá
# bằng khoá này (xem mục cuối file). BẮT BUỘC đổi ở production, 32 byte base64.
#   Cách lấy: tự sinh — openssl rand -base64 32
#   ⚠️ Nếu đổi khoá này SAU KHI đã có credential lưu trong DB, các credential cũ sẽ KHÔNG giải mã
#      được nữa — phải nhập lại toàn bộ integration credentials qua UI sau khi đổi khoá lần đầu.
SFMS_CRED_MASTER_KEY=

# ─── Face Recognition Service (microservice Python riêng, xem sơ đồ kiến trúc) ───
# Bật khi đã deploy container face-recognition-service. Tắt (false) thì hệ thống bỏ qua
# nhận diện khuôn mặt, không cần chạy service này (dev/local mặc định tắt).
SFMS_FRS_ENABLED=false
SFMS_FRS_URL=http://face-recognition-service:8000

# ─── Firebase Cloud Messaging (push notification mobile + web) ───────────────
# Nguồn credential THẬT là System Admin → "Tích hợp hệ thống" (dán JSON Service Account vào ô
# credential của dòng "Firebase Cloud Messaging", mã hoá bằng SFMS_CRED_MASTER_KEY, lưu DB) —
# xem hướng dẫn lấy JSON này ở phần "Firebase" đã trao đổi trong chat lúc setup ban đầu.
# 2 biến dưới đây CHỈ để fallback lúc bootstrap (trước khi System Admin vào UI cấu hình) hoặc
# dev/test local — copy file JSON vào secrets/firebase-service-account.json (đã gitignore) rồi
# trỏ path vào đây. Nếu để trống + chưa cấu hình DB, hệ thống bỏ qua gửi push (không lỗi).
SFMS_FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json

# ─── Sao lưu CSDL (BR-160/161) ─────────────────────────────────────────────
# Cần binary pg_dump trong container (đã thêm vào Dockerfile: apk add postgresql-client).
# Mặc định đủ dùng — chỉ đổi nếu muốn giờ chạy khác hoặc nơi lưu file khác /app/data/backups.
SFMS_BACKUP_DIR=./data/backups
SFMS_BACKUP_CRON=0 0 2 * * *
SFMS_BACKUP_CAPACITY_BYTES=5368709120

# ─── Geofence (xác minh vị trí nhận hàng, BR-074) ─────────────────────────────
# Dev/local: false (no-op). Production: BẮT BUỘC true.
SFMS_GEOFENCE_ENFORCED=false

# ─── Tham số vận hành khác ─────────────────────────────────────────────────────
DELIVERY_DEVIATION_ALERT_MINUTES=30

# ─── KHÔNG cần điền ở đây (không phải biến ENV) ──────────────────────────────
# - GPS provider API key, Gemini API key, Firebase Cloud Messaging server key:
#   3 key này KHÔNG đọc từ ENV — System Admin nhập trực tiếp qua UI "Tích hợp hệ thống"
#   (/system-admin/integrations), backend mã hoá bằng SFMS_CRED_MASTER_KEY rồi lưu DB.
#   + Gemini key lấy tại: https://aistudio.google.com/apikey
#   + Firebase server key lấy tại: Firebase Console → Project Settings → Cloud Messaging
#     → "Server key" (Legacy) hoặc tạo Service Account key (HTTP v1 API).
#   + GPS provider: tuỳ nhà cung cấp thực tế sẽ chọn (chưa chốt ở TDS).
# - OpenStreetMap: không cần API key (dịch vụ mở, dùng free-tier Nominatim/tile server).
